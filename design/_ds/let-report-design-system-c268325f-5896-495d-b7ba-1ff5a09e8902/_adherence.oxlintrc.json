{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/content/**",
              "components/cta/**",
              "components/quiz/**",
              "ui_kits/social-posts/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Plus Jakarta Sans|Caveat))/i]",
        "message": "Font not provided by the design system. Available: Plus Jakarta Sans, Caveat."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|size|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, icon, size, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:topic|category|correct|incorrect|document|record)$/]",
        "message": "<Badge> variant must be one of 'topic' | 'category' | 'correct' | 'incorrect' | 'document' | 'record'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BenefitFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|follow|key|ref|className|style|children)$/]",
        "message": "<BenefitFooter> doesn't accept that prop. Declared props: items, follow."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|right|tagline|assetBase|key|ref|className|style|children)$/]",
        "message": "<BrandHeader> doesn't accept that prop. Declared props: logo, right, tagline, assetBase."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|state|icon|iconRight|fullWidth|disabled|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, state, icon, iconRight, fullWidth, disabled, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|success|secondary|navy)$/]",
        "message": "<Button> variant must be one of 'primary' | 'success' | 'secondary' | 'navy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|hover|active|disabled|correct|incorrect)$/]",
        "message": "<Button> state must be one of 'default' | 'hover' | 'active' | 'disabled' | 'correct' | 'incorrect'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|title|children|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: variant, title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:tip|warning|correct)$/]",
        "message": "<Callout> variant must be one of 'tip' | 'warning' | 'correct'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTABanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|subtitle|tone|key|ref|className|style|children)$/]",
        "message": "<CTABanner> doesn't accept that prop. Declared props: icon, title, subtitle, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTABanner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:navy|green)$/]",
        "message": "<CTABanner> tone must be one of 'navy' | 'green'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DayBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:day|label|size|pad|tone|key|ref|className|style|children)$/]",
        "message": "<DayBadge> doesn't accept that prop. Declared props: day, label, size, pad, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='DayBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<DayBadge> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DayBadge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:green|navy|blue)$/]",
        "message": "<DayBadge> tone must be one of 'green' | 'navy' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocumentIllustration'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|variant|lines|width|avatar|key|ref|className|style|children)$/]",
        "message": "<DocumentIllustration> doesn't accept that prop. Declared props: title, variant, lines, width, avatar."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocumentIllustration'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:procedure|form|instruction)$/]",
        "message": "<DocumentIllustration> variant must be one of 'procedure' | 'form' | 'instruction'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EduCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|number|title|icon|media|footer|children|padding|style|key|ref|className|style|children)$/]",
        "message": "<EduCard> doesn't accept that prop. Declared props: variant, number, title, icon, media, footer, children, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EduCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|question|answer|example|warning|success|educational)$/]",
        "message": "<EduCard> variant must be one of 'default' | 'question' | 'answer' | 'example' | 'warning' | 'success' | 'educational'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EduCard'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<EduCard> padding must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroCharacter'] > JSXAttribute > JSXIdentifier[name!=/^(?:character|pose|height|speech|speechSide|assetBase|key|ref|className|style|children)$/]",
        "message": "<HeroCharacter> doesn't accept that prop. Declared props: character, pose, height, speech, speechSide, assetBase."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroCharacter'] > JSXAttribute[name.name='character'] > Literal[value!=/^(?:vina|sokha|dara)$/]",
        "message": "<HeroCharacter> character must be one of 'vina' | 'sokha' | 'dara'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroCharacter'] > JSXAttribute[name.name='pose'] > Literal[value!=/^(?:half|full|portrait)$/]",
        "message": "<HeroCharacter> pose must be one of 'half' | 'full' | 'portrait'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroCharacter'] > JSXAttribute[name.name='speechSide'] > Literal[value!=/^(?:left|right|top-left)$/]",
        "message": "<HeroCharacter> speechSide must be one of 'left' | 'right' | 'top-left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroHeadline'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|subtitle|definitions|align|size|key|ref|className|style|children)$/]",
        "message": "<HeroHeadline> doesn't accept that prop. Declared props: eyebrow, title, subtitle, definitions, align, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroHeadline'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<HeroHeadline> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroHeadline'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:h1|display)$/]",
        "message": "<HeroHeadline> size must be one of 'h1' | 'display'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|title|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoLockup'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|height|assetBase|inverse|tagline|key|ref|className|style|children)$/]",
        "message": "<LogoLockup> doesn't accept that prop. Declared props: variant, height, assetBase, inverse, tagline."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoLockup'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:lockup|badge|wordmark)$/]",
        "message": "<LogoLockup> variant must be one of 'lockup' | 'badge' | 'wordmark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|tone|size|pad|key|ref|className|style|children)$/]",
        "message": "<NumberBadge> doesn't accept that prop. Declared props: n, tone, size, pad."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberBadge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|green|navy|soft)$/]",
        "message": "<NumberBadge> tone must be one of 'blue' | 'green' | 'navy' | 'soft'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:current|total|variant|label|key|ref|className|style|children)$/]",
        "message": "<ProgressIndicator> doesn't accept that prop. Declared props: current, total, variant, label."
      },
