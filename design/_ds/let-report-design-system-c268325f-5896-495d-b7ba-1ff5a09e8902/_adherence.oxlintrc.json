        "selector": "JSXOpeningElement[name.name='ProgressIndicator'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:bar|dots|steps)$/]",
        "message": "<ProgressIndicator> variant must be one of 'bar' | 'dots' | 'steps'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuizCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|illustration|question|options|answer|selected|reveal|onSelect|layout|density|key|ref|className|style|children)$/]",
        "message": "<QuizCard> doesn't accept that prop. Declared props: number, title, illustration, question, options, answer, selected, reveal, onSelect, layout, density."
