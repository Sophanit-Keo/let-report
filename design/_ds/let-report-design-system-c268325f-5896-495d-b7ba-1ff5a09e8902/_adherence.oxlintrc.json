      {
        "selector": "JSXOpeningElement[name.name='QuizCard'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:side|stack)$/]",
        "message": "<QuizCard> layout must be one of 'side' | 'stack'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuizCard'] > JSXAttribute[name.name='density'] > Literal[value!=/^(?:regular|compact)$/]",
        "message": "<QuizCard> density must be one of 'regular' | 'compact'."
