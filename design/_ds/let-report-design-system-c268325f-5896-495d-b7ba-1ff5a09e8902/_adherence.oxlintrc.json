        "selector": "JSXOpeningElement[name.name='TermHighlight'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|green)$/]",
        "message": "<TermHighlight> tone must be one of 'blue' | 'green'."
      }
