      {
        "selector": "JSXOpeningElement[name.name='RecordIllustration'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|columns|rows|width|key|ref|className|style|children)$/]",
        "message": "<RecordIllustration> doesn't accept that prop. Declared props: title, columns, rows, width."
